<%- include('partials/header') %>
<section class="page-hero"><div class="eyebrow">Administration</div><h1 class="page-title">Manage users</h1><p class="muted">Create and review admin, instructor and student accounts.</p></section>
<section class="page-layout"><div class="two-col"><div class="panel"><h3>Add a user</h3><form method="POST" action="/admin/users">
<div class="field"><label>Full name</label><input name="name" required></div><div class="field"><label>Email</label><input type="email" name="email" required></div><div class="field"><label>Temporary password (minimum 8 characters)</label><input type="password" name="password" minlength="8" required></div><div class="field"><label>Role</label><select name="role"><option value="student">Student</option><option value="instructor">Instructor</option><option value="admin">Admin</option></select></div><button class="btn">Create account</button></form></div>
<div><img class="detail-image" style="height:230px" src="https://images.unsplash.com/photo-1521737711867-e3b97375f902?w=900" alt="People collaborating"><div class="role-note" style="margin-top:15px">Passwords are securely hashed before they are stored in MySQL.</div></div></div>
<div class="panel" style="margin-top:25px"><h3>Registered users</h3><div class="table-wrap"><table class="table"><thead><tr><th>ID</th><th>Name</th><th>Email</th><th>Role</th><th>Created</th><th>Action</th></tr></thead><tbody>
<% users.forEach(u=>{ %><tr><td><%= u.user_id %></td><td><%= u.name %></td><td><%= u.email %></td><td><span class="pill"><%= u.role %></span></td><td><%= new Date(u.created_at).toLocaleDateString('en-IN') %></td><td><% if(u.user_id!==user.user_id){ %><form class="inline-form" method="POST" action="/admin/users/<%= u.user_id %>/delete" data-confirm="Delete this user?"><button class="btn btn-danger btn-small">Delete</button></form><% } else { %>Current user<% } %></td></tr><% }) %>
</tbody></table></div></div></section>
<%- include('partials/footer') %>
